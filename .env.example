# === RPC Configuration ===
# Primary Solana RPC (Ankr with API key)
RPC_URL=https://rpc.ankr.com/sol/YOUR_ANKR_API_KEY

# Multi-RPC for TX broadcast (comma-separated)
# TX yang sama dikirim ke semua RPC untuk maximize landing rate
RPC_URLS=https://rpc.ankr.com/sol/YOUR_ANKR_API_KEY,https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# === Wallet ===
# Path ke Solana keypair JSON
KEYPAIR_PATH=~/.config/solana/id.json

# === Mining Config ===
# Jumlah thread solver (default: jumlah CPU core)
THREADS=0

# Max nonce attempts per round sebelum refresh state
MAX_NONCES_PER_ROUND=16384

# Compute unit limit per mine TX
CU_LIMIT=1400000

# === Telegram Bot (Optional) ===
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
